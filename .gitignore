dist
.dev
.tmptools.yaml

# Secrets and local configuration — never commit
.env
.env.*
!.env.example
*.license

# Local working artefacts — not versioned
plan/
docs/superpowers/

# Generator input: 56 near-duplicate spec files (~40 MB), reproducible with
# `make fetch-history`. The build depends only on the two committed specs.
api/specs/history/

# e2e estate: written by test/e2e/scripts/up.sh, carries a live API key.
test/e2e/.estate.json
test/e2e/.kubeconfig

# Derived from the estate by the provisioner: EDGE_ID/EDGE_KEY for docker
# compose --env-file, carries a live edge enrolment key.
test/e2e/.edge.env

# Licence lock: records which leg (compose or kubernetes) currently holds
# the single-use Business Edition licence, so a second leg refuses to
# activate it instead of colliding with the first. Never carries the
# licence key itself -- only the holder, when it was taken, and the estate
# file it belongs to.
test/e2e/.licence.lock

# Harness scratch: isolated worktrees created for subagents.
.claude/worktrees/

# Binaries a `go build ./cmd/<name>` drops in the repository root. The build
# output belongs in dist/ (see the Makefile); these are what an ad-hoc
# `go build ./cmd/gen_applicability/` leaves behind, and one of them reached a
# commit before this rule existed.
/gen_applicability
/gen_action_inputs
/audit_1to1
/audit_discovery
/audit_e2e_gaps
/audit_spec_delta
/audit_spec_drift
/audit_spec_reality
/fetch_spec
/portainer-mcp
