# Copy to .env (gitignored) and fill in your own value. Never commit .env.
#
# Used only by test/e2e: without it, `make e2e-up` still provisions the
# Community Edition leg, and suites that need Business Edition skip with a
# named reason instead of failing. See the "End-to-end (e2e) testing" section
# of README.md.
PORTAINER_LICENSE=

# Only used by the *-remote targets (make e2e-up-remote, make e2e-k8s-up-remote):
# the SSH destination of a Docker host to run the estate on instead of this
# machine -- a Host from ~/.ssh/config, or user@host. Setting this alone
# changes nothing: `make e2e-up` and `make e2e-k8s-up` always use the local
# Docker daemon regardless of this value. See "Running the estate on another
# machine" in README.md.
PORTAINER_E2E_DOCKER_SSH=
